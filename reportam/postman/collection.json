{
    "info": {
        "_postman_id": "8b9cad0e-1f20-4cad-9cad-0e1f20319cad",
        "name": "ReportAm API",
        "description": "Comprehensive collection for ReportAm civic reporting backend. Synced with reportam/lib/api.ts and reportam_admin/lib/api.ts.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Admin Auth",
            "description": "Authentication endpoints for administrative users.",
            "item": [
                {
                    "name": "Admin Login",
                    "request": {
                        "method": "POST",
                        "description": "Authenticate an administrator and receive a JWT token.",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@reportam.com\",\n  \"password\": \"password123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/login",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "login"]
                        }
                    }
                },
                {
                    "name": "Admin Me",
                    "request": {
                        "method": "GET",
                        "description": "Retrieve the profile information for the currently authenticated administrator.",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/auth/me",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "auth", "me"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Locations",
            "description": "Endpoints for fetching geographic data like states and LGAs.",
            "item": [
                {
                    "name": "Get States",
                    "request": {
                        "method": "GET",
                        "description": "Fetch a list of all supported states.",
                        "url": "{{baseUrl}}/api/locations/states"
                    }
                },
                {
                    "name": "Get LGAs in State",
                    "request": {
                        "method": "GET",
                        "description": "Fetch all Local Government Areas (LGAs) within a specific state.",
                        "url": {
                            "raw": "{{baseUrl}}/api/locations/states/:stateId/lgas",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "locations", "states", ":stateId", "lgas"],
                            "variable": [
                                {
                                    "key": "stateId",
                                    "value": "PASTE_STATE_ID_HERE"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Approved Communities (by LGA)",
                    "request": {
                        "method": "GET",
                        "description": "Fetch all approved communities within a specific LGA.",
                        "url": {
                            "raw": "{{baseUrl}}/api/locations/lgas/:lgaId/communities",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "locations", "lgas", ":lgaId", "communities"],
                            "variable": [
                                {
                                    "key": "lgaId",
                                    "value": "PASTE_LGA_ID_HERE"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Reports",
            "description": "Public endpoints for submitting and viewing civic reports.",
            "item": [
                {
                    "name": "Create Report (FormData)",
                    "request": {
                        "method": "POST",
                        "description": "Submit a new civic report using multipart/form-data (required by backend for image upload).",
                        "header": [],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                { "key": "type", "value": "community", "type": "text" },
                                { "key": "category", "value": "Road", "type": "text" },
                                { "key": "description", "value": "Road is flooded near the junction", "type": "text" },
                                { "key": "state_id", "value": "PASTE_STATE_ID_HERE", "type": "text" },
                                { "key": "city", "value": "Ibadan", "type": "text" },
                                { "key": "lga_id", "value": "PASTE_LGA_ID_HERE", "type": "text" },
                                { "key": "community_name", "value": "Elebu", "type": "text" },
                                { "key": "address_text", "value": "Elebu junction", "type": "text" },
                                { "key": "lat", "value": "7.3775", "type": "text" },
                                { "key": "lng", "value": "3.9470", "type": "text" },
                                { "key": "image", "type": "file", "src": [] }
                            ]
                        },
                        "url": "{{baseUrl}}/api/reports"
                    }
                },
                {
                    "name": "Emergency Report (FormData)",
                    "request": {
                        "method": "POST",
                        "description": "Submit an urgent emergency/SOS report using multipart/form-data.",
                        "header": [],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                { "key": "type", "value": "general", "type": "text" },
                                { "key": "category", "value": "Emergency", "type": "text" },
                                { "key": "description", "value": "🚨 EMERGENCY SOS ALERT - Immediate assistance required!", "type": "text" },
                                { "key": "address_text", "value": "Emergency at: 7.3775, 3.9470", "type": "text" },
                                { "key": "lat", "value": "7.3775", "type": "text" },
                                { "key": "lng", "value": "3.9470", "type": "text" }
                            ]
                        },
                        "url": "{{baseUrl}}/api/reports/emergency"
                    }
                },
                {
                    "name": "Get Report Feed",
                    "request": {
                        "method": "GET",
                        "description": "Retrieve a paginated, filterable list of public reports.",
                        "url": {
                            "raw": "{{baseUrl}}/api/reports?page=1&limit=20",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "reports"],
                            "query": [
                                { "key": "page", "value": "1" },
                                { "key": "limit", "value": "20" },
                                { "key": "status", "value": "pending", "disabled": true },
                                { "key": "category", "value": "Road", "disabled": true },
                                { "key": "is_emergency", "value": "true", "disabled": true }
                            ]
                        }
                    }
                },
                {
                    "name": "Mark Affected",
                    "request": {
                        "method": "POST",
                        "description": "Indicate that a report affects you.",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/reports/:id/affected",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "reports", ":id", "affected"],
                            "variable": [
                                { "key": "id", "value": "PASTE_REPORT_ID_HERE" }
                            ]
                        }
                    }
                },
                {
                    "name": "Unmark Affected",
                    "request": {
                        "method": "DELETE",
                        "description": "Remove the affected mark from a report.",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/reports/:id/affected",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "reports", ":id", "affected"],
                            "variable": [
                                { "key": "id", "value": "PASTE_REPORT_ID_HERE" }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Comments",
                    "request": {
                        "method": "GET",
                        "description": "Fetch all comments for a specific report.",
                        "url": {
                            "raw": "{{baseUrl}}/api/reports/:id/comments",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "reports", ":id", "comments"],
                            "variable": [
                                { "key": "id", "value": "PASTE_REPORT_ID_HERE" }
                            ]
                        }
                    }
                },
                {
                    "name": "Post Comment",
                    "request": {
                        "method": "POST",
                        "description": "Post a comment (or reply) on a specific report.",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"text\": \"This is my comment\",\n  \"username\": \"Anonymous User\",\n  \"parentId\": null\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/reports/:id/comments",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "reports", ":id", "comments"],
                            "variable": [
                                { "key": "id", "value": "PASTE_REPORT_ID_HERE" }
                            ]
                        }
                    }
                },
                {
                    "name": "Like Comment",
                    "request": {
                        "method": "POST",
                        "description": "Like a comment by its ID.",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"ReportAm User\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/comments/:commentId/like",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "comments", ":commentId", "like"],
                            "variable": [
                                { "key": "commentId", "value": "PASTE_COMMENT_ID_HERE" }
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Community Requests",
            "description": "Manage requests for adding new communities to the platform.",
            "item": [
                {
                    "name": "Submit Community Request",
                    "request": {
                        "method": "POST",
                        "description": "Submit a request to add a new community to the system.",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"community_name\": \"New Community\",\n  \"street_name\": \"Main Street\",\n  \"state_id\": \"PASTE_ID_HERE\",\n  \"city\": \"Ibadan\",\n  \"lga_id\": \"PASTE_ID_HERE\",\n  \"address_description\": \"Optional details\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": "{{baseUrl}}/api/community-requests"
                    }
                },
                {
                    "name": "Get All Requests (Admin)",
                    "request": {
                        "method": "GET",
                        "description": "Retrieve all pending community addition requests (Admin only).",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                        ],
                        "url": "{{baseUrl}}/api/community-requests/admin"
                    }
                },
                {
                    "name": "Approve Community Request (Admin)",
                    "request": {
                        "method": "POST",
                        "description": "Approve a community addition request (Admin only).",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/community-requests/admin/:id/approve",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "community-requests", "admin", ":id", "approve"],
                            "variable": [{ "key": "id", "value": "PASTE_REQUEST_ID_HERE" }]
                        }
                    }
                },
                {
                    "name": "Reject Community Request (Admin)",
                    "request": {
                        "method": "POST",
                        "description": "Reject a community addition request (Admin only).",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/community-requests/admin/:id/reject",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "community-requests", "admin", ":id", "reject"],
                            "variable": [{ "key": "id", "value": "PASTE_REQUEST_ID_HERE" }]
                        }
                    }
                }
            ]
        },
        {
            "name": "Admin Reports",
            "description": "Administrative endpoints for managing and reviewing reports.",
            "item": [
                {
                    "name": "Get All Reports (Admin)",
                    "request": {
                        "method": "GET",
                        "description": "Retrieve all reports (Admin only). Supports optional status filter.",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/reports?status=pending",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "reports"],
                            "query": [
                                { "key": "status", "value": "pending", "disabled": true }
                            ]
                        }
                    }
                },
                {
                    "name": "Update Report Status (Admin)",
                    "request": {
                        "method": "PATCH",
                        "description": "Update the status of a report (e.g., pending → resolved).",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"status\": \"resolved\"\n}",
                            "options": { "raw": { "language": "json" } }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/reports/:id/status",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "reports", ":id", "status"],
                            "variable": [{ "key": "id", "value": "PASTE_REPORT_ID_HERE" }]
                        }
                    }
                },
                {
                    "name": "Delete Report (Admin)",
                    "request": {
                        "method": "DELETE",
                        "description": "Permanently delete a report from the system.",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/reports/:id",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "reports", ":id"],
                            "variable": [{ "key": "id", "value": "PASTE_REPORT_ID_HERE" }]
                        }
                    }
                }
            ]
        },
        {
            "name": "Admin Comments",
            "description": "Administrative endpoints for managing user comments.",
            "item": [
                {
                    "name": "Get All Comments (Admin)",
                    "request": {
                        "method": "GET",
                        "description": "Retrieve all comments across all reports (Admin only).",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                        ],
                        "url": "{{baseUrl}}/api/admin/comments"
                    }
                },
                {
                    "name": "Delete Comment (Admin)",
                    "request": {
                        "method": "DELETE",
                        "description": "Permanently delete a comment by ID (Admin only).",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/admin/comments/:id",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "admin", "comments", ":id"],
                            "variable": [{ "key": "id", "value": "PASTE_COMMENT_ID_HERE" }]
                        }
                    }
                }
            ]
        },
        {
            "name": "Uploads",
            "description": "Endpoints for handling file and image uploads.",
            "item": [
                {
                    "name": "Upload Image",
                    "request": {
                        "method": "POST",
                        "description": "Upload an image file to the server and receive the URL back.",
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                { "key": "image", "type": "file", "src": [] }
                            ]
                        },
                        "url": "{{baseUrl}}/api/uploads/image"
                    }
                }
            ]
        }
    ],
    "event": [
        {
            "listen": "prerequest",
            "script": { "type": "text/javascript", "exec": [""] }
        },
        {
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [""] }
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "https://reportam-backend-sun4.onrender.com",
            "type": "string"
        },
        {
            "key": "adminToken",
            "value": "",
            "type": "string",
            "description": "Set this after running Admin Login"
        }
    ]
}